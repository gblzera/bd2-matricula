            <mxPoint x="5036" y="1054" />
            <mxPoint x="5036" y="216" />
          </Array></mxGeometry>
        </mxCell>
        <mxCell id="fk_log" value="referência lógica, SEM FK [C11]" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=9;labelBackgroundColor=#FFFFFF;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;fontColor=#b85450;" edge="1" parent="1" source="t_log_matricula_r2" target="t_matricula_r1">
          <mxGeometry relative="1" as="geometry"><Array as="points">
            <mxPoint x="8461" y="1056" />
            <mxPoint x="8461" y="644" />
          </Array></mxGeometry>
        </mxCell>
        <mxCell id="n_titulo" value="&lt;b style=&quot;font-size:16px&quot;&gt;Normalização &amp;#8212; 1FN, 2FN e 3FN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Teste de cada forma citado da &lt;b&gt;Tabela 15.1&lt;/b&gt; de Elmasri e Navathe (6ª ed., p. 353); a coluna da direita é o veredito destas 41 tabelas, com a evidência.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1800" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n_h0" value="&lt;b&gt;Forma normal&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_h1" value="&lt;b&gt;Teste (Elmasri, Tab. 15.1)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="190" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_h2" value="&lt;b&gt;Neste modelo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f0f0f0;strokeColor=#999999;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="1060" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_0_0" value="&lt;b style=&quot;font-size:15px&quot;&gt;1FN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="140" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n_0_1" value="A relação não deve ter atributos multivalorados ou relações aninhadas. &lt;i&gt;Solução: formar novas relações para cada atributo multivalorado ou relação aninhada.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="220" width="560" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n_0_2" value="&lt;b&gt;Atende &amp;#8212; e a ampliação é, em grande parte, a 1FN levada a sério.&lt;/b&gt; Telefones, documentos, formações do professor, recursos da sala, docentes da turma, avaliações e presenças eram multivalorados implícitos (ou colunas fixas nota_a1/a2/p3) e viraram tabela: &lt;code&gt;telefone&lt;/code&gt;, &lt;code&gt;documento_pessoa&lt;/code&gt;, &lt;code&gt;formacao_professor&lt;/code&gt;, &lt;code&gt;sala_recurso&lt;/code&gt;, &lt;code&gt;turma_professor&lt;/code&gt;, &lt;code&gt;avaliacao&lt;/code&gt;/&lt;code&gt;nota&lt;/code&gt;, &lt;code&gt;aula&lt;/code&gt;/&lt;code&gt;presenca&lt;/code&gt;.&lt;br&gt;&lt;b&gt;Exceção declarada:&lt;/b&gt; &lt;code&gt;log_matricula.detalhe_log_matricula&lt;/code&gt; é &lt;code&gt;jsonb&lt;/code&gt; &amp;#8212; auditoria, fora do núcleo. &lt;code&gt;timerange&lt;/code&gt;/&lt;code&gt;daterange&lt;/code&gt;/&lt;code&gt;tstzrange&lt;/code&gt; contam como &lt;b&gt;atômicos&lt;/b&gt;: um intervalo é um valor, indivisível para o operador &lt;code&gt;&amp;amp;&amp;amp;&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="220" width="1060" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n_1_0" value="&lt;b style=&quot;font-size:15px&quot;&gt;2FN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="140" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n_1_1" value="Para relações em que a chave primária contém múltiplos atributos, nenhum atributo não chave deverá ser funcionalmente dependente de uma parte da chave primária. &lt;i&gt;Solução: decompor.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="460" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n_1_2" value="&lt;b&gt;Atende.&lt;/b&gt; Com PK substituta, o teste honesto usa &lt;b&gt;todas as chaves candidatas&lt;/b&gt; (seção 15.4) &amp;#8212; e elas são os UNIQUEs do modelo: &lt;code&gt;sala (prédio, código)&lt;/code&gt;, &lt;code&gt;turma (período, código)&lt;/code&gt;, &lt;code&gt;curriculo (curso, ano)&lt;/code&gt;, &lt;code&gt;matricula (aluno, turma)&lt;/code&gt;, &lt;code&gt;avaliacao (turma, nome)&lt;/code&gt;, &lt;code&gt;plano_ensino (disciplina, turma)&lt;/code&gt;, &lt;code&gt;feriado (nível, data)&lt;/code&gt; etc. Em nenhuma um atributo não chave depende de metade da chave. As PKs realmente compostas (&lt;code&gt;pre_requisito&lt;/code&gt;, &lt;code&gt;curriculo_disciplina&lt;/code&gt;, &lt;code&gt;turma_professor&lt;/code&gt;, &lt;code&gt;sala_recurso&lt;/code&gt;, &lt;code&gt;presenca&lt;/code&gt;, &lt;code&gt;nota&lt;/code&gt;, &lt;code&gt;plano_ensino_bibliografia&lt;/code&gt;) têm atributos que dependem do &lt;b&gt;par&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="460" width="1060" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n_2_0" value="&lt;b style=&quot;font-size:15px&quot;&gt;3FN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="140" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n_2_1" value="A relação não deve ter um atributo não chave determinado funcionalmente por outro atributo não chave (dependência transitiva sobre a chave primária). &lt;i&gt;Solução: decompor.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="690" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n_2_2" value="&lt;b&gt;Atende, com TRÊS violações deliberadas &amp;#8212; cada uma fechada por um mecanismo do SGBD.&lt;/b&gt;&lt;br&gt;&lt;b&gt;(a) [C13]&lt;/b&gt; &lt;code&gt;ch_total_disciplina&lt;/code&gt; é determinada por teórica+prática: &lt;code&gt;GENERATED ALWAYS AS ... STORED&lt;/code&gt; torna a divergência impossível.&lt;br&gt;&lt;b&gt;(b) [C10]&lt;/b&gt; &lt;code&gt;turma_horario.id_periodo_letivo&lt;/code&gt; é derivável via turma: exigida pelo EXCLUDE de choque de sala; a FK composta anula o risco.&lt;br&gt;&lt;b&gt;(c) [E13]&lt;/b&gt; &lt;code&gt;id_turma&lt;/code&gt; em &lt;code&gt;aula&lt;/code&gt;, &lt;code&gt;presenca&lt;/code&gt; e &lt;code&gt;nota&lt;/code&gt; é derivável pelas junções: é o preço de trocar TRIGGERS de coerência por FK compostas &amp;#8212; a mesma figura de (b), aplicada três vezes. Nota de aluno de outra turma é &lt;b&gt;impossível por constraint&lt;/b&gt;.&lt;br&gt;&lt;b&gt;E a ampliação REMOVEU transitivas que o esboço tinha:&lt;/b&gt; o tipo do feriado (nacional/estadual/…) era determinado pelo arco de FKs &amp;#8212; saiu do modelo [E10]; &lt;code&gt;cidade_campus&lt;/code&gt; era determinada pelo endereço &amp;#8212; virou cadeia &lt;code&gt;endereco&amp;#8594;cidade&amp;#8594;estado&amp;#8594;pais&lt;/code&gt; [E1]; média e frequência saíram de &lt;code&gt;historico&lt;/code&gt; e agora só existem derivadas (MV) [E14]." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="690" width="1060" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n_rodape" value="&lt;b&gt;Resumo.&lt;/b&gt; As 41 tabelas estão em &lt;b&gt;3FN&lt;/b&gt;; as três exceções são conscientes, localizadas e fechadas por coluna gerada ou FK composta &amp;#8212; forma normal usada como régua, não como lei. &lt;b&gt;FNBC não foi verificada&lt;/b&gt;: afirmar conformidade iria além do que se testou." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1004" width="1760" height="64" as="geometry" />
        </mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; chave primária &amp;#183; &lt;b&gt;FK&lt;/b&gt; chave estrangeira &amp;#183; &lt;b&gt;PK,FK&lt;/b&gt; participa de PK/UNIQUE &amp;#183; &lt;b&gt;U&lt;/b&gt; UNIQUE &amp;#183; &lt;b&gt;GEN&lt;/b&gt; coluna gerada &amp;#183; &lt;b&gt;&amp;#9888;&lt;/b&gt; sem FK de propósito [C11] &amp;#183; &lt;b&gt;IDENTITY&lt;/b&gt; &lt;code&gt;GENERATED ALWAYS AS IDENTITY&lt;/code&gt;&lt;br&gt;Linhas &amp;#9492; em itálico = restrições de tabela. Pé-de-galinha no lado &lt;b&gt;muitos&lt;/b&gt;; a única aresta que anda para a direita é &lt;code&gt;departamento &amp;#8594; professor&lt;/code&gt; (chefe, FK circular criada por ALTER [E6]).&lt;br&gt;&lt;b&gt;[C#]&lt;/b&gt; = correção sobre o modelo do professor &amp;#183; &lt;b&gt;[E#]&lt;/b&gt; = decisão da ampliação (página 2).&lt;br&gt;&lt;b&gt;Fora do desenho, no mesmo DDL:&lt;/b&gt; a view &lt;code&gt;v_desempenho_matricula&lt;/code&gt; &amp;#8212; sucessora da coluna GERADA que [E14] removeu de &lt;code&gt;historico&lt;/code&gt;. Média (com a regra da substitutiva) e frequência agora são DERIVADAS de &lt;code&gt;nota&lt;/code&gt; e &lt;code&gt;presenca&lt;/code&gt;; &lt;code&gt;mv_historico_consolidado&lt;/code&gt; (04_views) materializa essa derivação e carrega o índice de faixa de média.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores:&lt;/b&gt; &lt;span style=&quot;background:#d0e8f2&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; geografia &amp;#160; &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; pessoas/vida acadêmica &amp;#160; &lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; infraestrutura &amp;#160; &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; currículo/plano &amp;#160; &lt;span style=&quot;background:#ffe6cc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; oferta/avaliação &amp;#160; &lt;span style=&quot;background:#f8cecc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; auditoria" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="2648" width="1700" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="decisoes" name="2 · Ampliação · decisões E1–E16 e impacto">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_titulo" value="&lt;b style=&quot;font-size:22px&quot;&gt;Ampliação do modelo &amp;#8212; as decisões [E1]&amp;#8211;[E16]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;O modelo do professor é a base; o esboço do grupo (docs/esboco-schema-ampliado.md) foi revisado, testado em banco descartável e virou este DDL. Cada [E#] aparece marcado na página 1 e no &lt;code&gt;sql/01_ddl.sql&lt;/code&gt;.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1900" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d_E1_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E1]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E1_b" value="&lt;b&gt;Geografia normalizada.&lt;/b&gt; pais &amp;#8594; estado &amp;#8594; cidade &amp;#8594; endereco; campus e pessoa apontam para endereco. Mata a string repetida &quot;Brasília&quot; e dá dedup por nível." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="120" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E2_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E2]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="212" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E2_b" value="&lt;b&gt;Supertipo pessoa.&lt;/b&gt; aluno e professor viram especializações 1:1 (id_pessoa NOT NULL UNIQUE), não exclusivas. CPF é 1:1 com a pessoa no Brasil: fica em pessoa, obrigatório — preserva [C12]." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="212" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E3_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E3]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="304" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E3_b" value="&lt;b&gt;Multivalorados em tabela.&lt;/b&gt; telefone (um principal por índice parcial), documento_pessoa (um por tipo), formacao_professor, recurso/sala_recurso — 1FN." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="304" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E4_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E4]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="396" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E4_b" value="&lt;b&gt;usuario = ROLE.&lt;/b&gt; login_usuario é o nome da role do Postgres; encaixa na RLS al_&amp;lt;RA&amp;gt; existente. f_usuario_sessao() resolve a sessão para o log." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="396" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E5_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E5]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="488" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E5_b" value="&lt;b&gt;Prédio.&lt;/b&gt; sala muda de dono: campus vem via predio. [C4] evolui: UNIQUE (id_predio, codigo_sala)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="488" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E6_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E6]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E6_b" value="&lt;b&gt;Departamento.&lt;/b&gt; curso, disciplina e professor ganham dono. Chefe é FK circular criada por ALTER, com UNIQUE (chefia no máx. 1)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="580" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E7_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E7]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E7_b" value="&lt;b&gt;Plano de ensino DA DISCIPLINA.&lt;/b&gt; id_turma NULL = plano base; preenchido = versão da oferta. UNIQUE NULLS NOT DISTINCT (técnica de [C9]) + FK composta (técnica de [C6]). Decisão do grupo em 24/08." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="672" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E8_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E8]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="764" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E8_b" value="&lt;b&gt;Coordenação com vigência.&lt;/b&gt; daterange + EXCLUDE gist: um coordenador por curso a cada instante, sem trigger. Vigência aberta = daterange(inicio, NULL)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="764" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E9_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E9]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="856" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E9_b" value="&lt;b&gt;Janela de matrícula.&lt;/b&gt; periodo_matricula com tstzrange + EXCLUDE (período, tipo, janela). ENUM em GiST via btree_gist — validado no PG 17." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="856" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E10_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E10]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="948" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E10_b" value="&lt;b&gt;Feriado por arco exclusivo.&lt;/b&gt; o ALCANCE é exatamente uma das 4 FKs (CHECK de arco). O ENUM de tipo foi removido: seria derivável do arco (3FN). facultativo é flag ortogonal. Dedup por 4 índices parciais preserva [C9]." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="948" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E11_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E11]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E11_b" value="&lt;b&gt;Co-docência.&lt;/b&gt; turma.id_professor sai para turma_professor (papel, CH). Um TITULAR por turma via índice parcial único." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1040" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E12_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E12]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1132" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E12_b" value="&lt;b&gt;EAD.&lt;/b&gt; id_sala anulável em turma_horario; EXCLUDE de sala vira parcial (WHERE id_sala IS NOT NULL). Choque real continua barrado; dois horários EAD convivem." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1132" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E13_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E13]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1224" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E13_b" value="&lt;b&gt;Coerência por FK composta.&lt;/b&gt; id_turma viaja em aula, presenca e nota e é amarrado por FK composta aos dois lados — substitui 4 triggers de validação. Nota/presença de aluno de outra turma: impossível por constraint." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1224" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E14_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E14]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1316" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E14_b" value="&lt;b&gt;Avaliação flexível.&lt;/b&gt; avaliacao (peso 0–10, soma 10 por turma, substitutiva p/ regra da P3) + nota. historico vira consolidado (situação + fechamento); média e frequência derivam na MV mv_historico_consolidado. CUSTO ASSUMIDO: o GENERATED de [C13] e o índice B-tree de 46× migram para a MV (aceita índice e REFRESH CONCURRENTLY — validado)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1316" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E15_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E15]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1408" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E15_b" value="&lt;b&gt;Aproveitamento de matéria.&lt;/b&gt; dispensa por estudo anterior, com parecer e avaliador (usuario); entra como 2ª via de pode_cursar(). Regras de deferimento cruzam tabelas: ficam na função, não em CHECK." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1408" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E16_a" value="&lt;b style=&quot;font-size:14px&quot;&gt;[E16]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8f0fe;strokeColor=#4a6da7;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1500" width="70" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_E16_b" value="&lt;b&gt;Dois turnos, não três.&lt;/b&gt; o ENUM do professor traz MATUTINO/VESPERTINO/NOTURNO; esta instituição opera só de manhã e à noite. Rótulo que o domínio não usa é rótulo que um dia entra por engano &amp;#8212; &lt;code&gt;turno_t&lt;/code&gt; fica com dois valores. A base do professor segue com os três, documentada à parte." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#cccccc;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="1500" width="1400" height="92" as="geometry" />
        </mxCell>
        <mxCell id="d_impacto" value="&lt;b style=&quot;font-size:14px&quot;&gt;O que quebrou de propósito, e o que vem a seguir&lt;/b&gt;&lt;br&gt;&amp;#8226; O DDL novo está validado (banco descartável + bateria comportamental de 14 casos) e aplicado em &lt;code&gt;matricula_v2&lt;/code&gt;. A base &lt;code&gt;matricula&lt;/code&gt; continua com o modelo de 16 tabelas — é ela que roda as demos até a migração terminar.&lt;br&gt;&amp;#8226; &lt;b&gt;02_carga&lt;/b&gt; precisa nascer de novo: gerar geografia, pessoas, documentos, usuários, planos, avaliações, aulas e presenças para os 120 alunos — e o volume legado (~33 mil matrículas) passa a render ~100 mil notas e &amp;gt;1 milhão de presenças: massa nova para os índices BRIN/parciais do Marco 2.&lt;br&gt;&amp;#8226; &lt;b&gt;03–08 e 90&lt;/b&gt; reescrevem em seguida (consultas trocam a.nome_aluno por junção com pessoa; RLS ganha usuario; os 4 índices são re-medidos — o B-tree de 46× agora vive na MV).&lt;br&gt;&amp;#8226; Regras que cruzam tabelas (janela de matrícula, feriado × aula, soma de pesos, CH das unidades, deferimento de aproveitamento) ficam nas FUNÇÕES — e todo trigger de validação cross-table tem a mesma corrida da anomalia da última vaga: é o gancho da ampliação com o Marco 2." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1612" width="1470" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
