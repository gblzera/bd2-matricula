        <mxCell id="ce_log_t" value="sem FK [C11]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="ce_log">
