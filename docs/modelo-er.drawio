        <mxCell id="l_leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; chave primária &amp;#183; &lt;b&gt;FK&lt;/b&gt; chave estrangeira &amp;#183; &lt;b&gt;PK,FK&lt;/b&gt; participa da PK ou de UNIQUE composto &amp;#183; &lt;b&gt;U&lt;/b&gt; UNIQUE &amp;#183; &lt;b&gt;GEN&lt;/b&gt; coluna gerada (GENERATED ALWAYS AS ... STORED) &amp;#183; &lt;b&gt;&amp;#9888;&lt;/b&gt; referência sem FK, de propósito&lt;br&gt;Cardinalidade em pé-de-galinha: o lado &amp;#8220;muitos&amp;#8221; fica na tabela que carrega a FK. Linha tracejada vermelha = referência lógica sem integridade referencial [C11].&lt;br&gt;&lt;b&gt;[C#]&lt;/b&gt; aponta a correção aplicada ao modelo do professor &amp;#8212; ver página 3 e &lt;code&gt;docs/correcoes-modelo-logico.md&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nomenclatura [C14]:&lt;/b&gt; toda PK é &lt;code&gt;id_&amp;lt;tabela&amp;gt;&lt;/code&gt;; a FK recebe &lt;b&gt;o mesmo nome da PK que referencia&lt;/b&gt; (permite &lt;code&gt;JOIN ... USING&lt;/code&gt;); quando há papel, o nome carrega o papel (&lt;code&gt;pre_requisito.id_disciplina&lt;/code&gt; + &lt;code&gt;id_requisito&lt;/code&gt;); demais colunas levam o sufixo &lt;code&gt;_&amp;lt;tabela&amp;gt;&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="l_areas" value="&lt;b&gt;Áreas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; infraestrutura &amp;#160; &lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; currículo &amp;#160; &lt;span style=&quot;background:#ffe6cc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; oferta &amp;#160; &lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; vida acadêmica &amp;#160; &lt;span style=&quot;background:#f8cecc&quot;&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; auditoria" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1480" y="900" width="320" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
