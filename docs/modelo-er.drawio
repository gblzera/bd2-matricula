        <mxCell id="c_leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&amp;#9633; retângulo = entidade &amp;#160;&amp;#160; &amp;#9671; losango = relacionamento &amp;#160;&amp;#160; &amp;#9711; elipse = atributo do relacionamento&lt;br&gt;&amp;#9635; retângulo duplo = &lt;b&gt;entidade associativa&lt;/b&gt; (relacionamento N:M que ganhou PK própria porque outras tabelas o referenciam)&lt;br&gt;(min,max) = cardinalidade, &lt;b&gt;lida do lado da entidade&lt;/b&gt;: cada instância dela participa de no mínimo &lt;i&gt;min&lt;/i&gt; e no máximo &lt;i&gt;max&lt;/i&gt; instâncias do relacionamento (notação (min,max) de Elmasri).&lt;br&gt;Linha tracejada vermelha = referência &lt;b&gt;sem&lt;/b&gt; chave estrangeira, de propósito [C11].&lt;br&gt;&lt;br&gt;&lt;b&gt;Critério aplicado:&lt;/b&gt; junção N:M com chave composta permanece &lt;i&gt;relacionamento&lt;/i&gt; (grade, requer). Junção com PK própria e referenciada por terceiros vira &lt;i&gt;entidade associativa&lt;/i&gt; (MATRICULA, TURMA_HORARIO)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="1180" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
